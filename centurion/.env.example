# Centurion secrets. Copy to .env and fill in for live operation.
# NOTE: No third-party AI API keys appear here by design. All inference is
# local via the LanguageProvider interface. There is intentionally no
# ANTHROPIC_API_KEY / OPENAI_API_KEY / GOOGLE_API_KEY.

# --- Revenue (Stripe) ---
# Leave blank to run in mock mode (no real money moves).
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Alerts / remote approval (optional Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OPERATOR_PHONE_NUMBER=

# --- Alerts (optional SMTP email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
OPERATOR_EMAIL=

# --- Local Language Engine (self-hosted only) ---
# Default Ollama endpoint on the local host. Must be a local/self-hosted URL.
OLLAMA_HOST=http://localhost:11434

# --- Dashboard ---
# Token required to use the remote pause/kill button.
CENTURION_DASHBOARD_TOKEN=change-me
