# Copy this file to .env and fill in what you use.

# --- Option A: Claude API (best quality, needs a key from console.anthropic.com) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8

# --- Option B: Ollama (100% free and local, no key needed) ---
# Install from https://ollama.com then run:  ollama pull llama3.2
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Server port (default 3000)
# PORT=3000
